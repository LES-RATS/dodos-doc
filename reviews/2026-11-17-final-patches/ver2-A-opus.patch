+//! Verification of lot A of the second round of reviews (V2-A): the pure
+//! functions of `abi/` that the report `reports/v2-A-opus.md` attacks,
+//! reproduced here from the code and run. A test that passes says the
+//! weakness is there; a test named `..._panics` uses `catch_unwind`, since
+//! the test profile keeps the overflow checks of the workspace's
+//! `Cargo.toml`.
+use dodos_abi::aarch64;
+use dodos_abi::x86_64::{dr7_valid, msi_direct};
+use dodos_abi::{
+    AttachWord, ClockPage, ExceptionUse, FaultKind, GateWord, Geometry, Owner, Ownership, PageSize,
+    REQUESTS_PER_PEER, RESERVES_MAX, RingHeader, RoleWord, SENDS_PER_PEER, NodeMessage, TIME_LIMIT,
+    TraceCode, firing_instant, module_frames, trace_index,
+};
+use std::panic::catch_unwind;
+
+fn geometry() -> Geometry {
+    Geometry {
+        page_shift: [12, 21, 30, 0],
+        entries: 512,
+        levels: 4,
+        user_end: (1 << 47) - (1 << 30),
+    }
+}
+
+// Finding 2: a watchpoint taken at the kernel's own level (0x35) is the
+// kernel's, whatever the access was.
+
+#[test]
+fn ver2a_a_watchpoint_at_the_kernels_own_level_is_not_the_threads() {
+    // ESR_ELx.EC = 0x35, watchpoint without a change of Exception level.
+    assert_eq!(aarch64::exception_use(0x35 << 26), Some(ExceptionUse::NotThread));
+    // 0x34, the same watchpoint from EL0, is the thread's.
+    assert_eq!(
+        aarch64::exception_use(0x34 << 26),
+        Some(ExceptionUse::Fault(FaultKind::HardwareBreakpoint))
+    );
+}
+
+// Finding 3: the index of sequence 0, which a kept debug area can hold.
+
+#[test]
+fn ver2a_trace_index_of_sequence_0_panics() {
+    assert_eq!(trace_index(1, 4_032), 0);
+    assert_eq!(trace_index(4_033, 4_032), 0);
+    let caught = catch_unwind(|| trace_index(0, 4_032));
+    println!("trace_index(0, 4032): {caught:?}");
+    assert!(caught.is_err(), "sequence 0 subtracts with overflow");
+}
+
+// Finding 4: a boot image's page shift overflows the check instead of being
+// refused.
+
+#[test]
+fn ver2a_geometry_valid_overflows_on_a_large_page_shift() {
+    let g = Geometry {
+        page_shift: [12, 250, 30, 0],
+        entries: 512,
+        levels: 4,
+        user_end: (1 << 47) - (1 << 30),
+    };
+    let caught = catch_unwind(|| g.valid());
+    println!("valid() on page_shift [12, 250, 30, 0]: {caught:?}");
+    assert!(caught.is_err(), "s[1] + per_level overflows u8");
+    // The same values, with the missing size made 0, are refused in words.
+    assert!(!Geometry {
+        page_shift: [12, 250, 0, 0],
+        ..g
+    }
+    .valid());
+}
+
+// Finding 5: `module_frames` on a module's length or address.
+
+#[test]
+fn ver2a_module_frames_overflows_on_a_length_and_on_an_address() {
+    let g = geometry();
+    let long = catch_unwind(|| module_frames(0, None, u64::MAX, g).count());
+    println!("module_frames(len = u64::MAX): {long:?}");
+    assert!(long.is_err(), "len.div_ceil(page) * page overflows");
+    let high = catch_unwind(|| module_frames(u64::MAX - 4095, None, 3 * 4096, g).count());
+    println!("module_frames(phys = 2^64 - 4096, 3 pages): {high:?}");
+    assert!(high.is_err(), "phys + offset overflows");
+}
+
+#[test]
+fn ver2a_module_frames_of_an_unaligned_address_are_unaligned_pages() {
+    let g = geometry();
+    let first = module_frames(0x1234, None, 2 * 4096, g).next().expect("a frame");
+    println!("module_frames(phys = 0x1234): {first:?}");
+    assert_eq!(first.size, PageSize::Page);
+    assert!(!(0x1234u64).is_multiple_of(g.page()), "on an unaligned address");
+}
+
+// Finding 6: an MSI whose physical destination is APIC ID 255.
+
+#[test]
+fn ver2a_msi_direct_accepts_the_broadcast_apic_id() {
+    assert_eq!(msi_direct(255, 0xEF), Some((0xFEEF_F000, 0xEF)));
+    assert_eq!(msi_direct(256, 0xEF), None);
+}
+
+// Finding 7: decodings that accept what no constructor writes.
+
+#[test]
+fn ver2a_a_handing_role_word_with_nobody_is_accepted() {
+    let nobody = RoleWord::handing(0xFFFF, 0xFFFF, 1);
+    assert!(RoleWord::from_raw(nobody.raw()).is_some(), "handing to nobody");
+    let itself = RoleWord::handing(3, 3, 1);
+    assert!(RoleWord::from_raw(itself.raw()).is_some(), "handing to itself");
+    let absent = RoleWord::held(0xFFFF, 1);
+    println!("held(ROLE_NOBODY): {:?}", RoleWord::from_raw(absent.raw()));
+}
+
+#[test]
+fn ver2a_an_owner_node_of_0xffff_reads_as_unclaimed() {
+    let word = Ownership::taken(Owner::Node(0xFFFF), 7);
+    println!(
+        "taken(Node(0xFFFF)) -> {:?}, from_raw {:?}",
+        word.owner(),
+        Ownership::from_raw(word.raw()).map(|w| w.owner())
+    );
+    assert_eq!(word.owner(), Owner::Unclaimed);
+    // And a node above the table, built directly, reads the same way.
+    let high = Ownership::taken(Owner::Node(2000), 7);
+    assert_eq!(high.owner(), Owner::Unclaimed);
+}
+
+#[test]
+fn ver2a_a_credit_index_past_the_credits_is_read_as_one() {
+    let credits = (REQUESTS_PER_PEER + SENDS_PER_PEER) as u8;
+    for index in credits..31u8 {
+        let header = RingHeader::new(
+            NodeMessage::UnitAnswer,
+            1,
+            (1, 1),
+            1,
+            Some((index, 5)),
+        );
+        println!("credit index {index}: {:?}", header.credit());
+        assert!(header.credit().is_some(), "index {index} names no credit");
+    }
+}
+
+#[test]
+fn ver2a_a_gate_word_takes_more_pages_than_a_chunk_of_512_has() {
+    let word = GateWord::from_raw(1 | (4_000u64) << 32);
+    println!("not_data 4000 on a chunk of 512 pages: {word:?}");
+    assert!(word.is_some());
+}
+
+#[test]
+fn ver2a_dr7_accepts_an_execution_breakpoint_with_a_length() {
+    // Local enable 0, R/W0 = 00 (execution), LEN0 = 11 (four bytes).
+    let word = 1 | 0b11 << 18;
+    println!("dr7 {word:#x}: {}", dr7_valid(word));
+    assert!(dr7_valid(word));
+}
+
+// Finding 8: pure functions outside the domain their callers keep.
+
+#[test]
+fn ver2a_firing_instant_at_and_beyond_the_time_limit_panics() {
+    assert_eq!(firing_instant(0, 0), 0);
+    assert_eq!(firing_instant(100, 100), 128);
+    let at = catch_unwind(|| firing_instant(TIME_LIMIT, 0));
+    println!("firing_instant(2^63, 0): {at:?}");
+    assert!(at.is_err(), "63 - 64 subtracts with overflow");
+}
+
+#[test]
+fn ver2a_clock_page_shift_of_128_panics() {
+    let page = ClockPage {
+        version: 1,
+        seq: 0,
+        shift: 128,
+        flags: 0,
+        mult: 1,
+        counter_base: 0,
+        ns_base: 0,
+    };
+    let read = catch_unwind(|| page.nanoseconds(10));
+    println!("shift 128: {read:?}");
+    assert!(read.is_err(), "a shift of 128 overflows");
+}
+
+#[test]
+fn ver2a_bandwidth_outside_its_domain_panics() {
+    let caught = catch_unwind(|| dodos_abi::bandwidth(10, 1 << 48));
+    println!("bandwidth(10, 2^48): {caught:?}");
+    assert!(caught.is_err());
+    let over = catch_unwind(|| dodos_abi::bandwidth(11, 10));
+    assert!(over.is_err(), "budget above the period");
+}
+
+#[test]
+fn ver2a_an_owner_reserve_past_the_reserves_overflows_its_code() {
+    assert_eq!(Owner::Reserve(RESERVES_MAX as u16 - 1).code(), 0xFFF7);
+    let caught = catch_unwind(|| Owner::Reserve(16).code());
+    println!("Owner::Reserve(16).code(): {caught:?}");
+    assert!(caught.is_err());
+}
+
+// The values the report says are sound, kept here so that the two findings
+// above are not read as a doubt on the rest of these decoders.
+
+#[test]
+fn ver2a_the_decoders_of_the_lot_agree_with_their_constructors_otherwise() {
+    assert!(!TraceCode::user(TraceCode::Refused));
+    assert!(TraceCode::user(TraceCode::UserEmit));
+    assert!(AttachWord::new(dodos_abi::AttachState::Detached, 4096).is_some());
+    assert_eq!(Ownership::taken(Owner::Node(0), 1).owner(), Owner::Node(0));
+}
