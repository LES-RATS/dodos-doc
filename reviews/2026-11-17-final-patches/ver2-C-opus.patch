+/// A unit of 2^17 domain numbers on a machine of two node slots: the
+/// numbers of a slot are cut to 16 bits and the ranges overlap.
+#[test]
+fn v8_the_domain_numbers_of_a_unit_are_cut_to_16_bits() {
+    let mut machine = Machine::example();
+    machine.iommus[0].domains = 1 << 17;
+    let (model, _) = Model::boot(&machine).expect("the machine boots");
+    let (zero, one) = (model.domain_range(0, 0), model.domain_range(0, 1));
+    println!("V8: slot 0 {zero:?}, slot 1 {one:?}");
+    assert!(one.contains(zero.start()), "the ranges do not overlap");
+}
