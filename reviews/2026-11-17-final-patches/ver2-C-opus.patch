+/// Node 0 (the asked node) writes its own `Report`s with the key asked as
+/// their next key, in its own ring to node 2; returns how many it rewrote.
+fn rewrite_reports(m: &mut S) -> u64 {
+    let mut n = 0u64;
+    m.sys.edit_table(|t| {
+        for entry in std::sync::Arc::make_mut(&mut t.rings)[0][2]
+            .kernel
+            .entries
+            .iter_mut()
+            .flatten()
+        {
+            if let crate::table::RingEntry::Message(msg) = entry
+                && let Body::Report { next, .. } = &mut msg.body
+                && *next != 0
+            {
+                *next = 0;
+                n += 1;
+            }
+        }
+    });
+    n
+}
+
+/// One event of the machine, or the clock moved to the next timer.
+fn step_one(m: &mut S, to: u64) -> bool {
+    match m.sys.events().first() {
+        Some(&event) => {
+            m.sys.fire(event);
+            true
+        }
+        None => match m
+            .sys
+            .models()
+            .filter_map(|(_, n)| n.next_timer())
+            .map(|(at, _)| at)
+            .min()
+        {
+            Some(next) => {
+                m.sys.move_clock(next.max(m.sys.now() + 1).min(to));
+                true
+            }
+            None => false,
+        },
+    }
+}
