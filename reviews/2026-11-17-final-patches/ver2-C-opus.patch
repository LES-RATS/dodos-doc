+/// Node 0 attached its device through node 1, the IOMMU role's holder.
+/// Node 2 writes a `UnitRequest` in its own ring to node 1 that detaches
+/// the device and names node 0 as the sender: node 1 clears node 0's
+/// context entry.
+#[test]
+fn v5c_a_detach_forged_in_another_nodes_name_clears_its_context_entry() {
+    use super::units::{DEVICE, IOMMU_ROLE, attached, three};
+    let mut m = three();
+    attached(&mut m, 0);
+    assert_eq!(m.sys.role(IOMMU_ROLE).holder(), 1);
+    let device = DEVICE as u16;
+    let unit = &m.sys.canonical().units[&IOMMU_ROLE];
+    let domain = unit.domains[&device];
+    let before = unit.entries.get(&device).copied();
+    println!("V5c: node 0's context entry before: {before:?}, domain {domain}");
+    let epoch = m.sys.role(IOMMU_ROLE).epoch();
+    let op = UnitOp::Detach {
+        device,
+        domain,
+        root: 0,
+    };
+    let body = Body::UnitRequest {
+        role: IOMMU_ROLE as u16,
+        epoch,
+        op,
+    };
+    let request = forged(&m, NodeMessage::UnitRequest, 0, 1, Some((5, 77)), body);
+    let refused = m.sys.node(1).refused.0;
+    m.sys.inject(2, 1, request);
+    m.run(30 * MS);
+    let after = m
+        .sys
+        .canonical()
+        .units[&IOMMU_ROLE]
+        .entries
+        .get(&device)
+        .copied();
+    println!(
+        "V5c: node 1 refused {} of ring 2 -> 1's messages; the context entry after: {after:?}",
+        m.sys.node(1).refused.0 - refused
+    );
+    assert_eq!(after, None, "the forged detach was refused");
+}
