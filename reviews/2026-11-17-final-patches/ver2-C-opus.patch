+/// Node 1 moves the producer index of its user ring to node 0 back below
+/// what node 0 has consumed: the resynchronisation wraps and the
+/// subtraction after it overflows.
+#[test]
+fn v6_a_producer_index_moved_back_overflows_the_receiver() {
+    let mut m = S::two();
+    for _ in 0..4 {
+        let body = Body::Signal {
+            grant: 3,
+            serial: 0,
+        };
+        let signal = forged(&m, NodeMessage::Signal, 1, 0, None, body);
+        m.sys.inject(1, 0, signal);
+        m.run(MS);
+    }
+    let consumed = m.sys.canonical().beacons[0].consumed[1].1;
+    println!("V6: node 0 has consumed {consumed} entries of ring 1 -> 0");
+    // The producer index is written by node 1 only, with plain stores.
+    m.sys
+        .edit_table(|t| std::sync::Arc::make_mut(&mut t.rings)[1][0].user.produced = 0);
+    let body = Body::Signal {
+        grant: 3,
+        serial: 0,
+    };
+    let signal = forged(&m, NodeMessage::Signal, 1, 0, None, body);
+    m.sys.inject(1, 0, signal);
+    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| m.sys.settle(100)));
+    println!("V6: node 0 served the ring: {outcome:?}");
+    assert!(outcome.is_err(), "the receiver did not panic");
+}
