+/// Three nodes; node 0 grants node 1 a frame and node 1 holds the remote
+/// capability. Node 2 writes a `Release` for that grant in its own ring to
+/// node 0, naming node 1 as its sender: node 0 frees node 1's grant.
+#[test]
+fn v5a_a_release_forged_by_a_third_node_frees_the_grantee_grant() {
+    let mut m = S::on(&machine(Arch::X86_64, 3, &[&[0], &[1], &[2]]));
+    let reply = m.retype(0, ObjectKind::Reply, 0, REPLY);
+    m.ok(0, reply);
+    let reply = m.retype(1, ObjectKind::Reply, 0, REPLY);
+    m.ok(1, reply);
+    let frame = m.retype(0, ObjectKind::Frame, 1, OBJ);
+    m.ok(0, frame);
+    assert_eq!(m.call(1, recv(GOT)), WAITS);
+    let message = Message {
+        label: 7,
+        flags: 0,
+        words: vec![7],
+        caps: vec![Transfer::Derive(s(OBJ), rights())],
+        marks: 0,
+    };
+    let call = Syscall::NodeSend {
+        node: node_cap(1),
+        message,
+        doorbell: SlotAddr::NONE,
+    };
+    assert_eq!(m.call(0, call), WAITS);
+    m.settle();
+    let grant = m.sys.node(0).grant_entries()[0].0;
+    let serial = m.sys.canonical().grants[0][&grant].serial;
+    let got = m.sys.node(1).object_at(m.t[1], s(GOT)).expect("the frame");
+    let remote = m.sys.node(1).remotes[&got];
+    assert!(m.sys.node(1).valid(&remote));
+    println!("V5a: grant {grant} serial {serial} is live; node 1's frame is valid");
+    let before = m.sys.node(0).refused.0;
+    let release = forged(&m, NodeMessage::Release, 1, 0, None, Body::Release { grant, serial });
+    m.sys.inject(2, 0, release);
+    m.run(20 * MS);
+    println!(
+        "V5a: node 0 refused {} of ring 2 -> 0's messages; grant after: {:?}; node 1's frame valid: {}",
+        m.sys.node(0).refused.0 - before,
+        m.sys.canonical().grants[0].get(&grant).is_some(),
+        m.sys.node(1).valid(&remote)
+    );
+    assert!(
+        !m.sys.canonical().grants[0].contains_key(&grant),
+        "the forged release was refused"
+    );
+}
