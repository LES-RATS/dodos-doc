+/// Node 1 grants node 0 a frame, then writes another node's floor into the
+/// `Send` it left in its own ring: node 0 maps node 2's memory, and the
+/// checker accepts the mapping.
+#[test]
+fn v4_the_granting_node_writes_the_frame_the_holder_maps() {
+    let mut m = S::on(&machine(Arch::X86_64, 3, &[&[0], &[1], &[2]]));
+    let reply = m.retype(0, ObjectKind::Reply, 0, REPLY);
+    m.ok(0, reply);
+    let frame = m.retype(1, ObjectKind::Frame, 1, OBJ);
+    m.ok(1, frame);
+    assert_eq!(m.call(0, recv(GOT)), WAITS);
+    let message = Message {
+        label: 7,
+        flags: 0,
+        words: vec![7],
+        caps: vec![Transfer::Derive(s(OBJ), rights())],
+        marks: 0,
+    };
+    let call = Syscall::NodeSend {
+        node: node_cap(0),
+        message,
+        doorbell: SlotAddr::NONE,
+    };
+    assert_eq!(m.call(1, call), WAITS);
+    // The floor of node 2, which node 1 reads in the fixed part of the
+    // machine table, as every kernel does.
+    let victim = m
+        .sys
+        .node(2)
+        .untypeds
+        .values()
+        .map(|u| u.base)
+        .min()
+        .expect("a floor");
+    let chunk = m.sys.node(2).machine.geometry.chunk();
+    println!("V4: node 2's floor starts at {victim:#x}, chunks of {chunk:#x}");
+    let pages = chunk / m.sys.node(2).machine.geometry.page();
+    // The granting node rewrites the frame of its own `Send` in its own
+    // ring: plain stores into memory only node 1's kernel writes.
+    m.sys.edit_table(move |t| {
+        for pair in std::sync::Arc::make_mut(&mut t.rings)[1].iter_mut() {
+            for entry in pair.user.entries.iter_mut().flatten() {
+                if let crate::table::RingEntry::Message(msg) = entry
+                    && let Body::Send { grants, .. } = &mut msg.body
+                {
+                    grants[0].frame.base = victim;
+                    grants[0].frame.pages = pages;
+                    grants[0].rights = Rights::ALL;
+                }
+            }
+        }
+    });
+    m.settle();
+    assert!(matches!(m.woken(0), Some(Ok(Output::Message(_)))));
+    let got = m.sys.node(0).object_at(m.t[0], s(GOT)).expect("the frame");
+    let placed = m.sys.node(0).frames[&got];
+    println!(
+        "V4: node 0 holds a remote frame at {:#x}, {} pages",
+        placed.base, placed.pages
+    );
+    let map = Syscall::ASpaceMap(Map {
+        space: s(START_SLOT_ASPACE),
+        frame: s(GOT),
+        untyped: SlotAddr::NONE,
+        address: 1 << 30,
+        first: 0,
+        count: 1,
+        rights: Rights::READ.union(Rights::WRITE).bits(),
+    });
+    let outcome = m.call(0, map);
+    println!("V4: node 0 maps it: {outcome:?}");
+    println!("V4: check after the map: {:?}", m.sys.check());
+    assert_eq!(placed.base, victim, "node 1 chose another node's frame");
+    assert_eq!(outcome, DONE);
+}
