+//! My own reproductions of the attacks of the Lot C report, written from
+//! the report's findings and the code, not copied from the author's file.
+
+use super::*;
+use crate::boot::Refusal;
+use crate::rings::{Body, UnitOp};
+use crate::{Map, Message, Range, Transfer};
+use dodos_abi::{Header, NodeMessage, RingHeader, START_SLOT_ASPACE, START_SLOT_MAILBOX};
+
+const REPLY: u32 = 100;
+const OBJ: u32 = 101;
+const GOT: u32 = 110;
+
+fn recv(first: u32) -> Syscall {
+    Syscall::Recv {
+        endpoint: s(START_SLOT_MAILBOX),
+        reply: s(REPLY),
+        range: Range {
+            first: s(first),
+            count: 4,
+        },
+        wait: 0,
+    }
+}
+
+fn rights() -> u32 {
+    Rights::READ
+        .union(Rights::WRITE)
+        .union(Rights::SEND)
+        .union(Rights::DERIVE)
+        .bits()
+}
+
+/// A message written into ring `from` -> `to`, with a header that names
+/// `sender`: what a hostile kernel of node `from` writes in its own ring.
+fn forged(
+    m: &S,
+    kind: NodeMessage,
+    sender: u16,
+    to: u16,
+    credit: Option<(u8, u32)>,
+    body: Body,
+) -> crate::rings::Message {
+    let t = m.sys.canonical();
+    let header = RingHeader::new(
+        kind,
+        body.entries() as u8,
+        (sender, t.generation(sender)),
+        t.generation(to),
+        credit,
+    );
+    crate::rings::Message { header, body }
+}
