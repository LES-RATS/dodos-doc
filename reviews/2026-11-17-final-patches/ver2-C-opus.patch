+/// A writable segment of the first service longer than the first block of
+/// node 0's floor: the start-up panics instead of refusing.
+#[test]
+fn v1_a_writable_segment_larger_than_the_first_untyped_panics() {
+    let mut machine = Machine::example();
+    let chunk = machine.geometry.chunk();
+    println!(
+        "V1: floor {} bytes = {} chunks; the writable segment becomes {} chunks",
+        machine.floors.floor_node,
+        machine.floors.floor_node / chunk,
+        8
+    );
+    machine.segments[1].len = 8 * chunk;
+    let outcome = std::panic::catch_unwind(|| Model::boot(&machine).map(|_| ()).map_err(|r| r));
+    match outcome {
+        Ok(Ok(())) => println!("V1: boot returned Ok"),
+        Ok(Err(refusal)) => println!("V1: boot refused {refusal:?}"),
+        Err(_) => println!("V1: boot panicked"),
+    }
+    assert!(outcome.is_err(), "the start-up did not panic");
+}
