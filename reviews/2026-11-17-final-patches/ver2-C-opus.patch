+/// A `BootNode` whose window times 64 overflows the u64 of the record.
+#[test]
+fn v2a_a_boot_node_window_that_overflows_panics() {
+    let mut machine = machine(Arch::X86_64, 2, &[&[0], &[1]]);
+    // A window of 2^58 names cores from 2^63: no layout of this machine
+    // can produce it, and the multiplication is done before the check.
+    machine.boot_nodes = Some((2, vec![(1u64 << 58, 1), (0, 0b11)]));
+    let outcome = std::panic::catch_unwind(|| Model::boot(&machine).map(|_| ()));
+    match outcome {
+        Ok(Ok(())) => println!("V2a: boot accepted the record"),
+        Ok(Err(refusal)) => println!("V2a: boot refused {refusal:?}"),
+        Err(_) => println!("V2a: boot panicked"),
+    }
+    assert!(outcome.is_err(), "the start-up did not panic");
+}
