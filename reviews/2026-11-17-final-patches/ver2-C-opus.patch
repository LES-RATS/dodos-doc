+/// The same forgery while node 1 has the frame mapped: the grant is freed
+/// and the translation stays, so node 0 may give the chunk out again.
+#[test]
+fn v5a2_a_release_forged_while_the_grantee_maps_frees_the_grant_under_the_mapping() {
+    let mut m = S::on(&machine(Arch::X86_64, 3, &[&[0], &[1], &[2]]));
+    let reply = m.retype(0, ObjectKind::Reply, 0, REPLY);
+    m.ok(0, reply);
+    let reply = m.retype(1, ObjectKind::Reply, 0, REPLY);
+    m.ok(1, reply);
+    let frame = m.retype(0, ObjectKind::Frame, 1, OBJ);
+    m.ok(0, frame);
+    assert_eq!(m.call(1, recv(GOT)), WAITS);
+    let message = Message {
+        label: 7,
+        flags: 0,
+        words: vec![7],
+        caps: vec![Transfer::Derive(s(OBJ), rights())],
+        marks: 0,
+    };
+    let call = Syscall::NodeSend {
+        node: node_cap(1),
+        message,
+        doorbell: SlotAddr::NONE,
+    };
+    assert_eq!(m.call(0, call), WAITS);
+    m.settle();
+    let grant = m.sys.node(0).grant_entries()[0].0;
+    let serial = m.sys.canonical().grants[0][&grant].serial;
+    let space = m
+        .sys
+        .node(1)
+        .object_at(m.t[1], s(START_SLOT_ASPACE))
+        .expect("an aspace");
+    let before = m.sys.node(1).aspaces[&space].translations.len();
+    let map = Syscall::ASpaceMap(Map {
+        space: s(START_SLOT_ASPACE),
+        frame: s(GOT),
+        untyped: SlotAddr::NONE,
+        address: 1 << 30,
+        first: 0,
+        count: 1,
+        rights: Rights::READ.union(Rights::WRITE).bits(),
+    });
+    assert_eq!(m.call(1, map), DONE, "node 1 maps the granted page");
+    let got = m.sys.node(1).object_at(m.t[1], s(GOT)).expect("the frame");
+    let placed = m.sys.node(1).frames[&got];
+    let leaves = m.sys.canonical().uses[1][&m.sys.node(1).remotes[&got].use_entry].leaves;
+    println!(
+        "V5a2: node 1 maps node 0's frame at {:#x}; its use entry counts {} leaves",
+        placed.base, leaves
+    );
+    let release = forged(&m, NodeMessage::Release, 1, 0, None, Body::Release { grant, serial });
+    m.sys.inject(2, 0, release);
+    // Events go by without the check, so that the state it forbids can be
+    // seen before it fails.
+    let to = m.sys.now() + 20 * MS;
+    while m.sys.now() < to {
+        m.sys.advance((m.sys.now() + 100_000).min(to));
+    }
+    let space = m.sys.node(1).object_at(m.t[1], s(START_SLOT_ASPACE)).expect("an aspace");
+    let mapping = m.sys.node(1).aspaces[&space].translations.len();
+    let check = m.sys.check();
+    println!(
+        "V5a2: grant live: {}; node 1's translations: {mapping}; check {check:?}",
+        m.sys.canonical().grants[0].contains_key(&grant),
+    );
+    assert!(
+        !m.sys.canonical().grants[0].contains_key(&grant),
+        "the forged release was refused"
+    );
+    assert_eq!(mapping, before + 1, "node 1's mapping went with the grant");
+    assert!(check.is_err(), "the checker accepts a translation under no grant");
+}
