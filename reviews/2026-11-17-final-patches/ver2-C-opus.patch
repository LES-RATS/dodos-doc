+/// While the rebuild never ends, a unit request of another node waits: the
+/// holder keeps it until the rebuild ends, and it never does.
+#[test]
+fn v7b_a_unit_request_waits_while_the_rebuild_never_ends() {
+    use super::units::{DEVICE, IOMMU_ROLE, IOSPACE, attach, three};
+    let mut m = three();
+    let kill = Syscall::NodeStop {
+        node: node_cap(1),
+        mode: dodos_abi::NODE_STOP_KILL,
+        core: 0,
+    };
+    m.ok(0, kill);
+    let to = m.sys.now() + 200 * MS;
+    let mut rewritten = 0u64;
+    for _ in 0..1200 {
+        if !step_one(&mut m, to) {
+            break;
+        }
+        rewritten += rewrite_reports(&mut m);
+    }
+    assert_eq!(m.sys.role(IOMMU_ROLE).holder(), 2);
+    assert!(!m.sys.node(2).rebuilds.is_empty(), "the rebuild ended");
+    println!("V7b: {rewritten} reports rewritten, the rebuild of node 2 runs");
+    // Node 0 asks the rebuilding holder for a device.
+    let iospace = m.retype(0, ObjectKind::IoSpace, 0, IOSPACE);
+    m.ok(0, iospace);
+    let call = attach(&m, 0, IOSPACE, DEVICE);
+    let outcome = m.call(0, call);
+    println!("V7b: node 0's attach: {outcome:?}");
+    assert_eq!(outcome, WAITS, "the request was not kept");
+    for _ in 0..800 {
+        if !step_one(&mut m, to) {
+            break;
+        }
+        rewritten += rewrite_reports(&mut m);
+    }
+    println!(
+        "V7b: {rewritten} reports rewritten; node 2 rebuilding {}; node 0 still waiting {}",
+        !m.sys.node(2).rebuilds.is_empty(),
+        m.woken(0).is_none()
+    );
+    assert!(!m.sys.node(2).rebuilds.is_empty(), "the rebuild ended");
+    assert!(m.woken(0).is_none(), "the request was answered");
+    assert_eq!(m.sys.check(), Ok(()));
+}
