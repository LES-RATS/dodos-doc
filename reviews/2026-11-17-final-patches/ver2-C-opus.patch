+/// Node 1 holds the unit roles and is killed; node 2 takes over and asks
+/// node 0. Node 0 answers every `ReportAsk` with a `Report` whose next key
+/// is the key asked, so the rebuild never ends.
+#[test]
+fn v7_a_report_whose_next_key_does_not_advance_stalls_the_rebuild() {
+    let mut m = super::units::three();
+    let kill = Syscall::NodeStop {
+        node: node_cap(1),
+        mode: dodos_abi::NODE_STOP_KILL,
+        core: 0,
+    };
+    m.ok(0, kill);
+    let (mut rewritten, mut fired, mut seen) = (0u64, 0u64, false);
+    let to = m.sys.now() + 200 * MS;
+    while m.sys.now() < to && fired < 4000 && m.sys.has(2) {
+        match m.sys.events().first() {
+            Some(&event) => m.sys.fire(event),
+            None => {
+                let next = m
+                    .sys
+                    .models()
+                    .filter_map(|(_, n)| n.next_timer())
+                    .map(|(at, _)| at)
+                    .min();
+                let Some(next) = next else { break };
+                m.sys.move_clock(next.max(m.sys.now() + 1).min(to));
+                continue;
+            }
+        }
+        // Node 0 writes, in its own ring to node 2, every `Report` with
+        // the key asked (0) as its next key.
+        m.sys.edit_table(|t| {
+            for entry in std::sync::Arc::make_mut(&mut t.rings)[0][2]
+                .kernel
+                .entries
+                .iter_mut()
+                .flatten()
+            {
+                if let crate::table::RingEntry::Message(msg) = entry
+                    && let Body::Report { next, .. } = &mut msg.body
+                    && *next != 0
+                {
+                    *next = 0;
+                    rewritten += 1;
+                }
+            }
+        });
+        fired += 1;
+        seen |= !m.sys.node(2).rebuilds.is_empty();
+        if fired % 500 == 0 {
+            assert_eq!(m.sys.check(), Ok(()));
+            println!(
+                "V7: {fired} events, {rewritten} reports rewritten, rebuilding {}, items {}",
+                !m.sys.node(2).rebuilds.is_empty(),
+                m.sys
+                    .node(2)
+                    .rebuilds
+                    .values()
+                    .map(|b| b.items.len())
+                    .sum::<usize>()
+            );
+        }
+    }
+    println!(
+        "V7: {fired} events, {rewritten} reports rewritten, node 2's IOMMU role {}, rebuilding {}",
+        m.sys.role(0).holder() == 2,
+        !m.sys.node(2).rebuilds.is_empty()
+    );
+    assert!(seen, "node 2 never rebuilt");
+    assert!(rewritten > 100, "the rebuild was not stalled");
+    assert!(
+        !m.sys.node(2).rebuilds.is_empty(),
+        "the rebuild ended despite the reports"
+    );
+    assert_eq!(m.sys.check(), Ok(()));
+}
