+/// Node 2 writes a `Send` in its own ring to node 0, naming node 1 in its
+/// header and node 1's start-up task in its stamp: node 0's receiver is
+/// told the message comes from node 1's task.
+#[test]
+fn v5b_a_send_forged_by_a_third_node_carries_another_nodes_task() {
+    let mut m = S::on(&machine(Arch::X86_64, 3, &[&[0], &[1], &[2]]));
+    let reply = m.retype(0, ObjectKind::Reply, 0, REPLY);
+    m.ok(0, reply);
+    assert_eq!(m.call(0, recv(GOT)), WAITS);
+    let task = dodos_abi::TaskId::new(1, 1).raw();
+    let header = Header::new(7, 1, 0, 0).expect("a header");
+    let body = Body::Send {
+        header,
+        stamp: (task, 0),
+        grants: vec![],
+        words: vec![42],
+    };
+    let send = forged(&m, NodeMessage::Send, 1, 0, None, body);
+    let before = m.sys.node(0).refused.0;
+    m.sys.inject(2, 0, send);
+    m.run(20 * MS);
+    let woken = m.woken(0).cloned();
+    println!("V5b: node 0 refused {}; its receiver woke with {woken:?}", m.sys.node(0).refused.0 - before);
+    let Some(Ok(Output::Message(delivery))) = woken else {
+        panic!("the forged send was not delivered");
+    };
+    println!(
+        "V5b: the task {} names node {}",
+        delivery.received.task,
+        dodos_abi::TaskId::from_raw(delivery.received.task).node()
+    );
+    assert_eq!(delivery.received.task, task);
+}
