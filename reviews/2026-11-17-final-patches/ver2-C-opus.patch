+/// A crash area off its chunk boundary: the start-up keeps a large page
+/// from it anyway, and the checker accepts a frame the size of a chunk at
+/// an address that is not on a chunk boundary.
+#[test]
+fn v3_a_crash_area_off_its_chunk_boundary_is_accepted() {
+    let mut machine = Machine::example();
+    let (page, large1) = (
+        machine.geometry.page(),
+        machine.geometry.bytes(PageSize::Large1).expect("a large page"),
+    );
+    machine.crash.0 += page;
+    let base = machine.crash.0;
+    let outcome = std::panic::catch_unwind(|| Model::boot(&machine));
+    let Ok(Ok((model, _))) = outcome else {
+        println!("V3: the start-up did not accept it: {outcome:?}");
+        panic!("the start-up refused the boot image");
+    };
+    let kept: Vec<_> = model
+        .frames
+        .values()
+        .filter(|f| f.page == PageSize::Large1 && f.base == base)
+        .collect();
+    println!(
+        "V3: boot accepted it; check {:?}; frames of the crash base {base:#x}: {}",
+        model.check(),
+        kept.len()
+    );
+    println!(
+        "V3: aligned on its page size: {}; base % {large1} = {}",
+        base.is_multiple_of(large1),
+        base % large1
+    );
+    let _ = Refusal::Floors;
+}
