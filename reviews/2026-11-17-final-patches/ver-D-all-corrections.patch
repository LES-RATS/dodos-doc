+/// DeepSeek 5: the tables rule 37 counts (its own formula) are those of
+/// `memory::tables`, and its iospace levels those of `memory::io_levels`,
+/// on every geometry `Geometry::valid` accepts.
+#[test]
+fn ver_d_rule_37_agrees_with_memory_tables_on_every_valid_geometry() {
+    use dodos_abi::{Geometry, PageSize};
+    let mut geometries = 0;
+    for s0 in 12u8..=32 {
+        let per = s0 - 3;
+        for levels in 1..=8u32 {
+            for n in 2..=3usize {
+                let mut page_shift = [0u8; 4];
+                for (i, shift) in page_shift.iter_mut().enumerate().take(n) {
+                    *shift = s0 + per * i as u8;
+                }
+                let mut g = Geometry {
+                    page_shift,
+                    entries: 1 << per,
+                    levels,
+                    user_end: 0,
+                };
+                g.user_end = g.chunk();
+                if !g.valid() {
+                    continue;
+                }
+                geometries += 1;
+                let span = |k: u32| u128::from(g.page()) * u128::from(g.entries).pow(k);
+                for size in PageSize::ALL.into_iter().filter(|&s| g.bytes(s).is_some()) {
+                    let bytes = u128::from(g.bytes(size).unwrap());
+                    let top = 1u128 << g.address_bits().min(63);
+                    for at in [0, bytes, 3 * bytes, top / 2 - bytes, top - bytes] {
+                        let at = at as u64;
+                        let mut hooked = BTreeSet::new();
+                        for k in (1..levels).filter(|&k| span(k) > bytes) {
+                            hooked.insert((k, u128::from(at) / span(k)));
+                        }
+                        let tables: BTreeSet<(u32, u128)> =
+                            crate::memory::tables([(at, size)].into_iter(), levels, g)
+                                .into_iter()
+                                .map(|(k, key)| (k, u128::from(key)))
+                                .collect();
+                        assert_eq!(hooked, tables, "{g:?} {size:?} {at:#x}");
+                    }
+                }
+                for width in u32::from(s0) + 1..=64 {
+                    let check = (1..=64).find(|&k| span(k) >= 1u128 << width).unwrap_or(64);
+                    assert_eq!(check, crate::memory::io_levels(g, width), "{g:?} {width}");
+                }
+            }
+        }
+    }
+    println!("VERPROBE geometries: {geometries}");
+    assert!(geometries > 3);
+}
