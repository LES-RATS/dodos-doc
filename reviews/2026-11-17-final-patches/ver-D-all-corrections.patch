+#[test]
+fn ver_d_kind_9_fault_waiting_on_its_endpoint() {
+    let mut k = K::new();
+    let thread = k.running(40, EP);
+    k.ok(Syscall::ThreadSuspend(s(40)));
+    let mut block = k.regs(40);
+    block[dodos_abi::x86_64::REG_DR0] = 0x1000;
+    block[dodos_abi::x86_64::REG_DR7] = 1;
+    k.ok(Syscall::ThreadWriteRegs {
+        thread: s(40),
+        block,
+    });
+    k.ok(Syscall::ThreadResume(s(40)));
+    k.m.fault(thread, FaultKind::HardwareBreakpoint, [1, 1, 0xFFFF_0FF1]);
+    assert_eq!(k.m.census().faulting, 1);
+    assert_eq!(k.m.check(), Ok(()));
+    assert_eq!(
+        k.m.census().fault_kinds[8],
+        0,
+        "kind 9 counted as no context"
+    );
+}
