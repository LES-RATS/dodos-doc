+/// core. The fresh start panics.
+#[test]
+fn ver2_a_fresh_start_adopts_the_sequences_a_dead_generation_left() {
+    let mut m = S::two();
+    let stop = Syscall::NodeStop {
+        node: node_cap(1),
+        mode: dodos_abi::NODE_STOP_KILL,
+        core: 0,
+    };
+    m.ok(0, stop);
+    m.settle();
+    m.run(7 * MS);
+    assert_eq!(m.state(1), MemberState::Dead);
+    m.sys.edit_table(|t| {
+        std::sync::Arc::make_mut(&mut t.crash).areas[1].next_kernel = u64::MAX;
+    });
+    let start = Syscall::NodeStart {
+        node: node_cap(1),
+        mode: dodos_abi::NODE_START_FRESH,
+        image: 0,
+        module: 0,
+        window: 0,
+        mask: 0b10,
+    };
+    let _ = m.sys.apply(0, m.t[0], start);
+    let to = m.sys.now() + 2 * MS;
+    while m.sys.now() < to {
+        let at = m.sys.now() + 100_000;
+        m.sys.advance(at);
+    }
+    let next = m.sys.canonical().crash.areas[1].next_kernel;
+    eprintln!("after the fresh start: node 1 {:?}, next kernel {next}", m.state(1));
+    assert_eq!(m.state(1), MemberState::Live);
