+//! Verification probes (ver2-D-opus). Every test here is written by the
+//! verifier and reaches its state by the calls a boot image or a user can
+//! make.
+
+mod common;
+
+use dodos_abi::*;
+use dodos_model::*;
+
+fn s(index: u32) -> SlotAddr {
+    SlotAddr::own(common::slot(index))
+}
+
+/// The machine of `Machine::example` with the iospace width the boot image
+/// asks for, booted, its device range taken and an `iospace` retyped in
+/// slot 30.
+fn iospace_on(width: u32) -> (Model, ObjId, Outcome) {
+    let mut machine = Machine::example();
+    machine.io_width = width;
+    let (mut m, t) = Model::boot(&machine).expect("the start-up takes any io_width");
+    common::take_device(&mut m, t);
+    let call = Syscall::UntypedRetype {
+        untyped: s(20),
+        kind: ObjectKind::IoSpace,
+        size: 0,
+        page: 0,
+        memory: 0,
+        destination: s(30),
+    };
+    let mut out = m.apply_settled(t, call.clone());
+    for _ in 0..1000 {
+        if out != Err(Error::Again) {
+            break;
+        }
+        out = m.apply_settled(t, call.clone());
+    }
+    (m, t, out)
+}
+
+/// The start-up checks read no `io_width`: a width of 8, of 64, of 125 and
+/// of 130 all boot, where the geometry's values are refused
+/// (`Machine::layout`).
+#[test]
+fn the_start_up_accepts_any_io_width() {
+    for width in [8, 64, 125, 130] {
+        let mut machine = Machine::example();
+        machine.io_width = width;
+        let booted = Model::boot(&machine);
+        eprintln!("io_width {width}: boot {:?}", booted.is_err());
+        assert!(booted.is_err(), "the start-up takes io_width {width}");
+    }
+    for width in [39, 48, 57, 63] {
+        let mut machine = Machine::example();
+        machine.io_width = width;
+        assert!(Model::boot(&machine).is_ok(), "the start-up refuses {width}");
+    }
+}
