+// Finding 6.
+
+#[test]
+fn ver_f6_a_grant_of_depth_0_does_not_stop_the_receiver() {
+    let mut m = S::two();
+    let reply = m.retype(1, ObjectKind::Reply, 0, 100);
+    m.ok(1, reply);
+    assert_eq!(m.call(1, recv(110)), WAITS);
+    let (gen0, gen1) = (m.sys.canonical().generation(0), m.sys.canonical().generation(1));
+    // Node 0, faulty, writes a live grant entry to node 1 through its own
+    // gate, and a Send naming it, with depth 0, into its own ring.
+    m.sys.edit_table(|t| {
+        t.grants[0].insert(
+            0,
+            crate::table::GrantEntry {
+                grantee: 1,
+                generation: gen1,
+                serial: 1,
+                state: crate::table::GrantState::Live,
+                answered: true,
+                use_index: Some(0),
+                doorbell: None,
+            },
+        );
+    });
+    let granted = crate::grants::Granted {
+        grant: 0,
+        serial: 1,
+        rights: Rights::READ.union(Rights::DERIVE),
+        depth: 0,
+        frame: crate::Frame {
+            page: dodos_abi::PageSize::Page,
+            pages: 1,
+            memory: dodos_abi::MemoryType::WriteBack,
+            base: 0x2000_0000,
+            kept: false,
+        },
+    };
+    let body = Body::Send {
+        header: dodos_abi::Header::new(0, 0, 1, 0).unwrap(),
+        stamp: (0, 0),
+        grants: vec![granted],
+        words: vec![],
+    };
+    let header = RingHeader::new(
+        dodos_abi::NodeMessage::Send,
+        body.entries() as u8,
+        (0, gen0),
+        gen1,
+        Some((dodos_abi::REQUESTS_PER_PEER as u8, 1)),
+    );
+    m.sys.inject(0, 1, crate::RingMessage { header, body });
+    // No check here: node 0's own state is the faulty kernel's.
+    m.sys.settle(100_000);
+    let placed = m.sys.node(1).object_at(m.t[1], s(110)).is_some();
+    let derive = Syscall::CapDerive {
+        source: s(110),
+        destination: s(111),
+        rights: Rights::READ.bits(),
+        badge: 0,
+    };
+    if !placed {
+        // The receive check refused the Send: node 1 still waits.
+        assert_eq!(m.woken(1), None);
+        return;
+    }
+    let t1 = m.t[1];
+    let outcome = catch_unwind(AssertUnwindSafe(|| m.sys.apply(1, t1, derive)));
+    assert!(outcome.is_ok(), "placed {placed}; the derive panicked");
+}
