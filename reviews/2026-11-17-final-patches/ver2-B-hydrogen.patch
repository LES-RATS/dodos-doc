+// The header that names another node than the ring it came on.
+
+#[test]
+fn ver_x_a_release_written_by_node_2_in_node_1s_name_is_refused() {
+    let mut m = three();
+    let ut = untyped_slot(m.sys.node(0), m.t[0]);
+    m.ok(0, retype_from(ut, ObjectKind::Untyped, 1 << 16, 160));
+    m.ok(0, retype_from(160, ObjectKind::Frame, 1, 101));
+    grant(&mut m, 0, 1, 101);
+    let map = Syscall::ASpaceMap(crate::Map {
+        space: s(dodos_abi::START_SLOT_ASPACE),
+        frame: s(110),
+        untyped: SlotAddr::NONE,
+        address: 1 << 30,
+        first: 0,
+        count: 1,
+        rights: Rights::READ.bits(),
+    });
+    m.ok(1, map);
+    let (index, entry) = m.sys.canonical().grants[0].iter().next().map(|(&i, &e)| (i, e)).unwrap();
+    assert_eq!(m.sys.canonical().uses[1].values().next().unwrap().leaves, 1);
+    // Node 2, faulty, writes into its own ring to node 0 a Release whose
+    // header names node 1, with node 1's generation (public words).
+    let body = Body::Release { grant: index, serial: entry.serial };
+    let header = RingHeader::new(
+        dodos_abi::NodeMessage::Release,
+        body.entries() as u8,
+        (1, m.sys.canonical().generation(1)),
+        m.sys.canonical().generation(0),
+        None,
+    );
+    m.sys.inject(2, 0, crate::RingMessage { header, body });
+    let to = m.sys.now() + 20 * MS;
+    m.sys.advance(to);
+    let live = m.sys.canonical().grants[0].contains_key(&index);
+    if !live {
+        // What follows: node 0 deletes its frame and makes an aspace whose
+        // root is the page node 1 still maps.
+        let base = m.sys.node(0).frames[&m.sys.node(0).object_at(m.t[0], s(101)).unwrap()].base;
+        let deleted = m.sys.apply(0, m.t[0], Syscall::CapDelete(s(101)));
+        let retyped = m.sys.apply(0, m.t[0], retype_from(160, ObjectKind::ASpace, 0, 102));
+        let aspace = m.sys.node(0).object_at(m.t[0], s(102));
+        let root = aspace.and_then(|a| m.sys.node(0).aspaces[&a].root);
+        let leaves = m.sys.canonical().uses[1].values().next().map(|u| u.leaves);
+        panic!(
+            "grant freed by a forged Release; delete {deleted:?}; frame base {base:x}; retype {retyped:?}, \
+             new root {root:x?}; node 1 leaves {leaves:?}; check {:?}",
+            m.sys.check()
+        );
+    }
+}
