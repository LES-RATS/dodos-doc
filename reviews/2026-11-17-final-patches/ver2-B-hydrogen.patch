+#[test]
+fn ver_f1b_a_second_block_cannot_map_the_first_blocks_page_table_writable() {
+    let mut m = three();
+    let shift = m.sys.canonical().geometry.chunk_shift();
+    let word = dodos_abi::Ownership::free(dodos_abi::Owner::Reserve(0)).raw();
+    let chunk = m.sys.canonical().owners.iter().position(|&w| w == word).unwrap() as u64;
+    let roles = slots_of(m.sys.node(0), m.t[0], ObjectKind::Role);
+    assert!(matches!(m.call(0, Syscall::RoleClaim(s(roles[2]))), Ok(Output::Epoch(_))));
+    let take = |destination| Syscall::MemoryTake {
+        control: control(),
+        kind: 0,
+        place: chunk << shift,
+        size: u64::from(shift),
+        destination: s(destination),
+    };
+    m.ok(0, take(160));
+    m.ok(0, retype_from(160, ObjectKind::ASpace, 0, 162));
+    let aspace = m.sys.node(0).object_at(m.t[0], s(162)).unwrap();
+    let root = m.sys.node(0).aspaces[&aspace].root.unwrap();
+    if m.sys.apply(0, m.t[0], take(161)).is_err() {
+        return;
+    }
+    let frame = m.sys.apply(0, m.t[0], retype_from(161, ObjectKind::Frame, 1, 163));
+    let base = m.sys.node(0).object_at(m.t[0], s(163)).map(|f| m.sys.node(0).frames[&f].base);
+    let map = Syscall::ASpaceMap(crate::Map {
+        space: s(dodos_abi::START_SLOT_ASPACE),
+        frame: s(163),
+        untyped: SlotAddr::NONE,
+        address: 1 << 31,
+        first: 0,
+        count: 1,
+        rights: Rights::READ.union(Rights::WRITE).bits(),
+    });
+    let mapped = m.sys.apply(0, m.t[0], map);
+    assert!(
+        mapped.is_err(),
+        "frame {frame:?} at {base:x?}, aspace root {root:x}; writable map {mapped:?}"
+    );
+}
