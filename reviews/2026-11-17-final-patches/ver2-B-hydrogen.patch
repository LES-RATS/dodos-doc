+// Finding 5.
+
+#[test]
+fn ver_f5_a_remote_frame_is_refused_as_a_message_page() {
+    let mut m = S::two();
+    let ut0 = untyped_slot(m.sys.node(0), m.t[0]);
+    let ut1 = untyped_slot(m.sys.node(1), m.t[1]);
+    m.ok(0, retype_from(ut0, ObjectKind::Untyped, 1 << 16, 160));
+    m.ok(0, retype_from(160, ObjectKind::Frame, 1, 101));
+    grant(&mut m, 0, 1, 101);
+    m.ok(1, retype_from(ut1, ObjectKind::CSpace, 256, 121));
+    m.ok(1, retype_from(ut1, ObjectKind::Thread, 0, 120));
+    let configure = Syscall::ThreadConfigure {
+        thread: s(120),
+        cspace: s(121),
+        aspace: SlotAddr::NONE,
+        fault: SlotAddr::NONE,
+        page: s(110),
+    };
+    let outcome = m.call(1, configure);
+    if outcome.is_ok() {
+        // What follows: node 0 deletes its frame; the grant is freed with
+        // no Revoke (the use entry counts no leaf), and the page becomes
+        // node 0's aspace root while node 1's thread keeps it.
+        let leaves = m.sys.canonical().uses[1].values().next().map(|u| u.leaves);
+        m.ok(0, Syscall::CapDelete(s(101)));
+        let grants = m.sys.node(0).grant_entries().len();
+        m.ok(0, retype_from(160, ObjectKind::ASpace, 0, 102));
+        let thread = m.sys.node(1).object_at(m.t[1], s(120)).unwrap();
+        let page = m.sys.node(1).threads[&thread].page;
+        panic!(
+            "configure {outcome:?}; leaves {leaves:?}; grants left {grants}; \
+             page still bound {}; check {:?}",
+            page.is_some(),
+            m.sys.check()
+        );
+    }
+    assert_eq!(outcome, Err(Error::Invalid));
+}
