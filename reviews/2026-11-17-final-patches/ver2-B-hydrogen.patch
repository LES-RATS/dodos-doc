+//! Verification of report v2-B-hydrogen. Each test asserts what the
+//! contract asks; a test that fails shows the model's behaviour.
+
+use super::units::{DEVICE, IOMMU_ROLE, IOSPACE, attach, attached, three};
+use super::*;
+use crate::rings::Body;
+use crate::{Range, Transfer};
+use dodos_abi::{NODE_START_FRESH, NODE_STOP_KILL, RingHeader, START_SLOT_MAILBOX};
+use std::panic::{AssertUnwindSafe, catch_unwind};
+
+const CONTROL: u32 = dodos_abi::START_SLOT_MEMORY_CONTROL;
+
+fn control() -> SlotAddr {
+    s(CONTROL)
+}
+
+fn kill(n: u16) -> Syscall {
+    Syscall::NodeStop {
+        node: node_cap(n),
+        mode: NODE_STOP_KILL,
+        core: 0,
+    }
+}
+
+fn fresh(n: u16, mask: u64) -> Syscall {
+    Syscall::NodeStart {
+        node: node_cap(n),
+        mode: NODE_START_FRESH,
+        image: 0,
+        module: 0,
+        window: 0,
+        mask,
+    }
+}
+
+fn recv(first: u32) -> Syscall {
+    Syscall::Recv {
+        endpoint: s(START_SLOT_MAILBOX),
+        reply: s(100),
+        range: Range { first: s(first), count: 1 },
+        wait: 0,
+    }
+}
+
+/// Node `from` grants its frame at `frame` to node `to`, whose thread
+/// receives it at slot 110.
+fn grant(m: &mut S, from: u16, to: u16, frame: u32) {
+    let reply = m.retype(to, ObjectKind::Reply, 0, 100);
+    m.ok(to, reply);
+    assert_eq!(m.call(to, recv(110)), WAITS);
+    let rights = Rights::READ.union(Rights::WRITE).bits();
+    let send = Syscall::NodeSend {
+        node: node_cap(to),
+        message: crate::Message {
+            caps: vec![Transfer::Derive(s(frame), rights)],
+            ..crate::Message::default()
+        },
+        doorbell: SlotAddr::NONE,
+    };
+    assert_eq!(m.call(from, send), WAITS);
+    m.settle();
+    assert_eq!(m.woken(from), Some(&Ok(Output::Sent { flags: 0 })));
+}
+
+// Finding 1.
+
+#[test]
+fn ver_f1_a_reserve_chunk_taken_by_this_generation_is_busy() {
+    let mut m = three();
+    let shift = m.sys.canonical().geometry.chunk_shift();
+    let word = dodos_abi::Ownership::free(dodos_abi::Owner::Reserve(0)).raw();
+    let chunk = m.sys.canonical().owners.iter().position(|&w| w == word).unwrap() as u64;
+    let roles = slots_of(m.sys.node(0), m.t[0], ObjectKind::Role);
+    // Role index 2 is reserve 0 on the reference machine.
+    assert!(matches!(m.call(0, Syscall::RoleClaim(s(roles[2]))), Ok(Output::Epoch(_))));
+    let take = |destination| Syscall::MemoryTake {
+        control: control(),
+        kind: 0,
+        place: chunk << shift,
+        size: u64::from(shift),
+        destination: s(destination),
+    };
+    m.ok(0, take(160));
+    // An aspace in the block: its root page is a table page.
+    m.ok(0, retype_from(160, ObjectKind::ASpace, 0, 162));
+    let again = m.sys.apply(0, m.t[0], take(161));
+    let check = m.sys.node(0).check();
+    assert_eq!((again, check), (Err(Error::Busy), Ok(())));
+}
+
+// Finding 2.
+
+#[test]
+fn ver_f2_a_split_is_busy_while_the_entry_keeps_frozen_leaves() {
+    let mut m = three();
+    let ut = untyped_slot(m.sys.node(0), m.t[0]);
+    attached(&mut m, 0);
+    let take = |destination| Syscall::MemoryTake {
+        control: control(),
+        kind: 1,
+        place: 0,
+        size: 0,
+        destination: s(destination),
+    };
+    m.ok(0, take(160));
+    let frame = Syscall::UntypedRetype {
+        untyped: s(160),
+        kind: ObjectKind::Frame,
+        size: 1,
+        page: 0,
+        memory: dodos_abi::MemoryType::Uncached as u64,
+        destination: s(161),
+    };
+    m.ok(0, frame);
+    let map = Syscall::IoSpaceMap(crate::Map {
+        space: s(IOSPACE),
+        frame: s(161),
+        untyped: s(ut),
+        address: 0x1000_0000,
+        first: 0,
+        count: 1,
+        rights: Rights::READ.bits(),
+    });
+    m.ok(0, map);
+    m.sys.break_unit(IOMMU_ROLE);
+    assert_eq!(m.call(0, Syscall::IoSpaceUnmap(s(161))), WAITS);
+    m.run(30 * MS);
+    assert_eq!(m.woken(0), Some(&Err(Error::Busy)));
+    m.ok(0, Syscall::CapDelete(s(161)));
+    let frozen = m.sys.canonical().device_leaves[0];
+    assert!(frozen > 0);
+    let give = Syscall::MemoryGive { control: control(), untyped: s(160), node: 1 };
+    m.no(0, give, Error::Busy);
+    let split = Syscall::MemorySplit { control: control(), untyped: s(160) };
+    let outcome = m.call(0, split);
+    if outcome.is_ok() {
+        // What follows the split: the lower half taken again, its leaf
+        // count reset, and given to node 1.
+        let taken = m.sys.apply(0, m.t[0], take(162));
+        let leaves = m.sys.canonical().device_leaves[0];
+        let give = Syscall::MemoryGive { control: control(), untyped: s(162), node: 1 };
+        let given = m.sys.apply(0, m.t[0], give);
+        let owner = m.sys.canonical().devices[0].owner;
+        panic!(
+            "split {outcome:?}; take {taken:?}; leaves {frozen} -> {leaves}; \
+             give {given:?}; owner {:?}",
+            owner.owner()
+        );
+    }
+    assert_eq!(outcome, Err(Error::Busy));
+}
+
+// Finding 3.
+
+#[test]
+fn ver_f3_the_pages_of_a_pinned_iospace_are_not_reused() {
+    let mut m = three();
+    let ut = untyped_slot(m.sys.node(0), m.t[0]);
+    m.ok(0, retype_from(ut, ObjectKind::Untyped, 1 << 20, 160));
+    m.ok(0, retype_from(160, ObjectKind::IoSpace, 0, IOSPACE));
+    let iospace = m.sys.node(0).object_at(m.t[0], s(IOSPACE)).unwrap();
+    let root = m.sys.node(0).aspaces[&iospace].root.unwrap();
+    let page = root / m.sys.canonical().geometry.page();
+    let call = attach(&m, 0, IOSPACE, DEVICE);
+    assert_eq!(m.call(0, call), WAITS);
+    m.run(30 * MS);
+    assert_eq!(m.woken(0), Some(&DONE));
+    m.sys.break_unit(IOMMU_ROLE);
+    let mut outcome = Err(Error::Again);
+    for _ in 0..8 {
+        outcome = m.call(0, Syscall::CapDelete(s(IOSPACE)));
+        if outcome != Err(Error::Again) {
+            break;
+        }
+        m.run(10 * MS);
+    }
+    assert_eq!(outcome, DONE);
+    let pinned = dodos_abi::PageClass::iospace_root(1);
+    assert_eq!(m.sys.canonical().classes.get(&page), pinned.as_ref());
+    // The untyped the iospace came from makes a new aspace.
+    let retyped = m.sys.apply(0, m.t[0], retype_from(160, ObjectKind::ASpace, 0, 162));
+    let new_root = m
+        .sys
+        .node(0)
+        .object_at(m.t[0], s(162))
+        .and_then(|a| m.sys.node(0).aspaces[&a].root);
+    let class = m.sys.canonical().classes.get(&page).copied();
+    let check = m.sys.node(0).check();
+    assert!(
+        new_root != Some(root) && class == pinned && check.is_ok(),
+        "retype {retyped:?}; new root {new_root:x?} (old {root:x}); class {class:?}; {check:?}"
+    );
+}
+
+// Finding 4: what the model does, which is what the contract says.
+
+#[test]
+fn ver_f4_after_a_failed_detach_an_unmap_lowers_the_count_with_no_invalidation() {
+    let mut m = three();
+    let ut = untyped_slot(m.sys.node(0), m.t[0]);
+    attached(&mut m, 0);
+    let iospace = m.sys.node(0).object_at(m.t[0], s(IOSPACE)).unwrap();
+    m.ok(0, retype_from(ut, ObjectKind::Frame, 1, 160));
+    let frame = m.sys.node(0).object_at(m.t[0], s(160)).unwrap();
+    let chunk = m.sys.node(0).frames[&frame].base >> m.sys.canonical().geometry.chunk_shift();
+    let before = m.sys.canonical().map_count(chunk);
+    let map = Syscall::IoSpaceMap(crate::Map {
+        space: s(IOSPACE),
+        frame: s(160),
+        untyped: s(ut),
+        address: 0x1000_0000,
+        first: 0,
+        count: 1,
+        rights: Rights::READ.bits(),
+    });
+    m.ok(0, map);
+    assert_eq!(m.sys.canonical().map_count(chunk), before + 1);
+    assert_eq!(m.call(0, attach(&m, 0, 0, DEVICE)), WAITS);
+    m.sys.break_unit(IOMMU_ROLE);
+    m.run(30 * MS);
+    assert_eq!(m.woken(0), Some(&Err(Error::Busy)));
+    // The unit is failed, the word stays attached, the device left the
+    // header.
+    assert!(m.sys.role(IOMMU_ROLE).failed());
+    let word = m.sys.canonical().attach_word(DEVICE as u32);
+    assert_eq!(word.state(), Some(dodos_abi::AttachState::Attached));
+    assert!(m.sys.node(0).iospaces[&iospace].is_empty());
+    // The unmap succeeds at once and lowers the map count: no unit request.
+    m.ok(0, Syscall::IoSpaceUnmap(s(160)));
+    assert_eq!(m.sys.canonical().map_count(chunk), before);
+    // The frame goes, and its bytes can be retyped.
+    m.ok(0, Syscall::CapDelete(s(160)));
+}
