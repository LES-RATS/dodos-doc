+// Observed in passing: the receiver takes the frame of a grant from the
+// Send, not from the granter's anchor.
+
+#[test]
+fn ver_y_a_send_cannot_name_a_frame_outside_its_grants_anchor() {
+    let mut m = three();
+    let frame = m.retype(0, ObjectKind::Frame, 1, 101);
+    m.ok(0, frame);
+    grant(&mut m, 0, 1, 101);
+    let (index, entry) = m.sys.canonical().grants[0].iter().next().map(|(&i, &e)| (i, e)).unwrap();
+    // A frame of node 2, which node 0 does not hold.
+    let other = m.retype(2, ObjectKind::Frame, 1, 101);
+    m.ok(2, other);
+    let base = m.sys.node(2).frames[&m.sys.node(2).object_at(m.t[2], s(101)).unwrap()].base;
+    assert_eq!(m.call(1, recv(112)), WAITS);
+    let granted = crate::grants::Granted {
+        grant: index,
+        serial: entry.serial,
+        rights: Rights::READ.union(Rights::WRITE),
+        depth: 2,
+        frame: crate::Frame {
+            page: dodos_abi::PageSize::Page,
+            pages: 1,
+            memory: dodos_abi::MemoryType::WriteBack,
+            base,
+            kept: false,
+        },
+    };
+    let body = Body::Send {
+        header: dodos_abi::Header::new(0, 0, 1, 0).unwrap(),
+        stamp: (0, 0),
+        grants: vec![granted],
+        words: vec![],
+    };
+    let header = RingHeader::new(
+        dodos_abi::NodeMessage::Send,
+        body.entries() as u8,
+        (0, m.sys.canonical().generation(0)),
+        m.sys.canonical().generation(1),
+        Some((dodos_abi::REQUESTS_PER_PEER as u8, 1)),
+    );
+    m.sys.inject(0, 1, crate::RingMessage { header, body });
+    m.sys.settle(100_000);
+    let placed = m.sys.node(1).object_at(m.t[1], s(112));
+    let Some(remote) = placed else { return };
+    let map = Syscall::ASpaceMap(crate::Map {
+        space: s(dodos_abi::START_SLOT_ASPACE),
+        frame: s(112),
+        untyped: SlotAddr::NONE,
+        address: 1 << 31,
+        first: 0,
+        count: 1,
+        rights: Rights::READ.union(Rights::WRITE).bits(),
+    });
+    let mapped = m.sys.apply(1, m.t[1], map);
+    let at = m.sys.node(1).frames[&remote].base;
+    assert!(
+        mapped.is_err(),
+        "node 1 maps {at:x}, node 2's frame {base:x}, writable: {mapped:?}; node 1 check {:?}",
+        m.sys.node(1).check()
+    );
+}
