// The catalogue: two levels, two packages, each versioned on its own.
//
// These interfaces hold types only. `kind` is the catalogue: a case name is
// the `kind` string of an os:core/ui node, its payload record is the node's
// `props` (JSON, see "Value encoding" in core.wit). The variant never crosses
// the ABI, so adding a case is a minor version, not a break.
//
// Entry criteria for a kind: semantic and not visual, accessible by
// construction, same rendering in every engine, adaptive layout with no
// absolute position. Everything else goes through an escape hatch (applet,
// WebGPU surface, web view).

/// Agent level: what the agent may emit, and the base of every application.
package os:catalog-agent@0.1.0 {
  interface kinds {
    /// As os:core/ui.node-id.
    type node-id = string;

    /// Name of a binding in the node's `objects`.
    type object-ref = string;

    enum direction { column, row }
    enum text-style { body, title, heading, caption, code }
    enum tone { neutral, accent, positive, warning, danger }
    enum field-kind { line, multiline, number, date, time, secret }

    /// Semantic icon names, frozen: a name keeps its meaning forever. The
    /// glyph set behind them (Material Symbols Rounded today) can be replaced
    /// without touching the ABI. An unknown name draws a neutral placeholder.
    /// OPEN: the document decides the principle, not the list. This is a
    /// starting set to review.
    enum icon-name {
      // who speaks
      agent, app, system, user,
      // verbs
      add, remove, edit, delete, search, share, copy, paste, undo, redo,
      open, save, send, download, upload, refresh, play, pause, stop,
      // navigation
      back, forward, up, down, close, menu, more,
      // things
      file, folder, image, audio, video, link, calendar, time, location,
      settings,
      // state
      check, info, warning, error, help, lock, unlock, private, untrusted,
    }

    record stack { direction: direction }
    record text { content: string, style: text-style, markdown: bool }
    record image { source: object-ref, alt: string }
    record icon { name: icon-name, alt: string }
    /// By value, so capped: at most 200 rows. More rows: `virtual-list` in
    /// os:catalog-app, fed on demand (rule 6).
    record table { columns: list<string>, rows: list<list<string>> }
    /// none = indeterminate.
    record progress { fraction: option<f32> }

    /// Where an action argument comes from.
    variant source {
      /// A JSON value, as text.
      literal(string),
      /// The current value of an input node, read by the system when the
      /// button is activated. The only way a secret field's value travels.
      input(node-id),
      /// An item bound on the button node.
      object(object-ref),
    }
    record argument { name: string, value: source }

    /// An action of the task scope. `app` is a component-id (os:core/types).
    /// Its effect class comes from the manifest, never from the tree.
    record invocation { app: string, name: string, args: list<argument> }

    /// With an action: activating it invokes the action through the task,
    /// under the same rules as `task.invoke`; the surface owner then gets
    ///   "completed"  {"entry": id, "output": {...}}, objects, provenance of
    ///                the result
    ///   "failed"     {"entry": id, "error": "<error case name>"}
    /// Without: event "activated".
    record button { label: string, tone: tone, action: option<invocation> }

    /// Event "changed" with the new value as a JSON string. For kind
    /// `secret`, the event carries null and `value` is ignored on update:
    /// the value never reaches the surface owner, only an action through
    /// `source.input`.
    record field { label: string, kind: field-kind, value: string }

    record choice-option { value: string, label: string }
    /// Event "changed" with the selected values as a JSON array.
    record choice { label: string, options: list<choice-option>, multiple: bool, selected: list<string> }
    /// Event "changed" with a JSON boolean.
    record toggle { label: string, on: bool }

    /// A system preview of an object, by its content type.
    record preview { source: object-ref }
    /// A JS applet stored as an object, run with no capability. It talks to
    /// the surface owner only by event "message" (a JSON value, origin the
    /// applet's publisher, always untrusted).
    record applet { source: object-ref }

    variant kind {
      // containers
      stack(stack),
      card,
      items,
      // content
      text(text),
      image(image),
      icon(icon),
      table(table),
      progress(progress),
      divider,
      // inputs
      button(button),
      field(field),
      choice(choice),
      toggle(toggle),
      // embedded
      preview(preview),
      applet(applet),
    }
  }
}

/// Application level: the kinds our own userland and catalogue applications
/// need beyond the agent's. An application surface accepts both levels; the
/// agent's overlay accepts only the agent level.
/// OPEN: the document names ten kinds "and a few more" without fields. The
/// fields below are the minimum that gives each kind a meaning.
package os:catalog-app@0.1.0 {
  interface kinds {
    use os:catalog-agent/kinds@0.1.0.{node-id, object-ref, icon-name};

    /// A long list fed on demand: the system sends "window"
    /// {"first": n, "count": m} for the range it needs, the owner answers
    /// with an update holding the `row` children of that range. Rows never
    /// travel all at once (rule 6).
    record virtual-list { count: u64 }
    /// Child of `virtual-list`; its own children are the row's content.
    record row { index: u64 }

    /// Children are `tree-item` nodes, nested by `parent`.
    /// Events on an item: "activated", "toggled" (JSON boolean: expanded).
    record tree-item { label: string, expandable: bool, expanded: bool }

    /// Children are `page` nodes; one is shown. Event "changed" with the
    /// selected page id. Used by both `tabs` and `navigation` (side
    /// navigation): same meaning, the engine picks the form per surface.
    record pages { selected: node-id }
    record page { label: string, icon: option<icon-name> }

    /// Children are `button`, `divider` and nested `menu` nodes.
    record menu { label: string }

    /// Event "dismissed" on the node when the user closes it.
    record dialog { title: string, modal: bool }

    /// Edits a text object in place: the text never travels by value. Needs
    /// `write` on the item unless read-only. Event "changed" with the new
    /// version as a number.
    record text-editor { source: object-ref, read-only: bool }

    /// Event "changed" with a JSON number.
    record slider { label: string, min: f64, max: f64, step: option<f64>, value: f64 }

    /// Events "changed" and "submitted" with the query as a JSON string.
    record search { label: string, value: string }

    /// A drawing area.
    /// OPEN: the document lists it without saying how one draws into it.
    record canvas { alt: string }

    /// Container: the user can drag it; the drop target's owner receives
    /// the listed items, read-only. Each needs `share`.
    record drag-source { items: list<object-ref> }

    /// Container accepting a drop of these media types (empty = any).
    /// Event "dropped" on the node, with the items in the event's `objects`.
    /// The drop is the grant: read-only capabilities, mediated by the shell.
    record drop-target { content-types: list<string> }

    variant kind {
      virtual-list(virtual-list),
      row(row),
      tree,
      tree-item(tree-item),
      tabs(pages),
      navigation(pages),
      page(page),
      menu(menu),
      dialog(dialog),
      text-editor(text-editor),
      slider(slider),
      search(search),
      canvas(canvas),
      drag-source(drag-source),
      drop-target(drop-target),
    }
  }
}
