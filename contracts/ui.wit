// The interface tree, in an open encoding.
//
// A node names its kind by a string and carries its fields as JSON. The kinds
// and their fields are defined as WIT types in two other packages
// (catalog.wit): os:catalog-agent and os:catalog-app, each with its own
// version. A new kind is a new minor version of a catalogue; this interface
// does not change, and a component built against an old catalogue keeps
// working. WIT stays the source: the A2UI catalogue and the SDK encoders are
// generated from those types.
//
// The tree carries meaning only: no style, no URL, no code, no position.

interface ui {
  use types.{error, provenance};
  use store.{binding};

  /// 1 to 64 bytes of [A-Za-z0-9_-], chosen by the surface owner, unique
  /// within the surface.
  type node-id = string;

  /// Flat list linked by ids: WIT has no recursive types, and a flat list
  /// streams and patches node by node.
  record node {
    id: node-id,
    /// none = top level.
    parent: option<node-id>,
    /// Case name of `kind` in a catalogue, e.g. "button".
    kind: string,
    /// JSON object: the payload record of that case. "{}" when the case has
    /// no payload. At most 65536 bytes.
    props: string,
    /// Items the props refer to by binding name (`object-ref` fields).
    objects: list<binding>,
  }

  /// Sent by the system. Open set of kinds: ignore the ones you do not know.
  /// Each catalogue documents the events of its kinds. Defined here:
  ///   "dismissed"  the surface was closed by the user; node is none
  record event {
    kind: string,
    node: option<node-id>,
    /// JSON; "null" when the event has no value.
    value: string,
    objects: list<binding>,
    /// Who the value comes from: "user" for what the user typed or chose,
    /// the applet's or the action's publisher for what they sent.
    provenance: provenance,
  }

  resource surface {
    /// Inserts or replaces nodes by id. Children keep arrival order. At most
    /// 1024 nodes per call. The system checks every update: known kind
    /// allowed on this surface (`unsupported`), props matching the kind,
    /// existing parent, actions within the task scope, caps (`invalid`,
    /// `too-large`). A rejected update changes nothing.
    update: async func(nodes: list<node>) -> result<_, error>;

    /// Removes the nodes and their descendants.
    remove: async func(ids: list<node-id>) -> result<_, error>;

    /// Ends when the surface is closed or revoked.
    events: func() -> stream<event>;
  }
}
